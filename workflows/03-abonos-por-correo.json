      {
        "parameters": {
          "jsCode": "const datos = $('Extraer datos').first().json.output;\n\nconst bruto = $input.all().map(function(i){ return i.json; });\nconst lista = [];\nfor (const b of bruto) {\n  if (Array.isArray(b)) {\n    for (const x of b) lista.push(x);\n  } else if (b && b.id) {\n    lista.push(b);\n  } else if (b && Array.isArray(b.apartados)) {\n    for (const x of b.apartados) lista.push(x);\n  }\n}\nconst activos = lista.filter(function(e){ return e && e.id && e.estado === 'activo'; });\n\nfunction norm(s) {\n  return (s || '')\n    .toLowerCase()\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^a-z0-9 ]/g, ' ')\n    .trim();\n}\n\nlet candidatos = [];\nconst concepto = norm(datos.concepto);\nconst m = concepto.match(/(apartado|pedido|encargo)\\s*(\\d+)/);\nif (m) {\n  const num = Number(m[2]);\n  candidatos = activos.filter(function(e){ return e.id === num; });\n} else {\n  const t = norm(datos.ordenante).split(/\\s+/).filter(Boolean);\n  candidatos = activos.filter(function(e){\n    const c = norm(e.cliente).split(/\\s+/);\n    if (t.length < 2) return false;\n    if (c[0] !== t[0]) return false;\n    for (let i = 1; i < c.length; i++) {\n      if (c[i].indexOf(t[1]) === 0) return true;\n      if (t[1].indexOf(c[i]) === 0) return true;\n    }\n    return false;\n  });\n}\n\nconst importe = Number(datos.importe);\nlet forma = datos.forma_pago;\nif (forma === 'transferencia') forma = 'bizum';\n\nconst base = {\n  ordenante: datos.ordenante,\n  importe: importe,\n  forma_pago: forma,\n  concepto: datos.concepto\n};\n\nif (candidatos.length !== 1) {\n  const motivo = candidatos.length\n    ? 'Hay varios apartados posibles'\n    : 'No he encontrado ningun apartado activo de esa persona';\n  return [{ json: Object.assign({}, base, { decision: 'revisar', motivo: motivo }) }];\n}\n\nconst e = candidatos[0];\nconst hoy = new Date().toISOString().slice(0, 10);\n\nif (importe > Number(e.pendiente)) {\n  const motivo = 'Paga ' + importe + ' EUR pero al apartado #' + e.id + ' solo le faltan ' + e.pendiente + ' EUR';\n  return [{ json: Object.assign({}, base, { decision: 'revisar', apartado_id: e.id, motivo: motivo }) }];\n}\n\nif (e.fecha_limite < hoy) {\n  const motivo = 'El apartado #' + e.id + ' esta fuera de plazo (limite: ' + e.fecha_limite + ')';\n  return [{ json: Object.assign({}, base, { decision: 'revisar', apartado_id: e.id, motivo: motivo }) }];\n}\n\nreturn [{ json: Object.assign({}, base, { decision: 'registrar', apartado_id: e.id, motivo: 'Coincide con un unico apartado' }) }];"
        },
