    {
      "parameters": {
        "jsCode": "// Los HTTP pueden traer la lista partida en items o en un solo item: la desenvolvemos\nfunction desenvolver(nodo) {\n  const bruto = nodo.all().map(i => i.json);\n  const lista = [];\n  for (const b of bruto) {\n    if (Array.isArray(b)) { for (const x of b) lista.push(x); }\n    else if (b && b.id) { lista.push(b); }\n  }\n  return lista.filter(x => x && typeof x.importe === 'number');\n}\n\nconst ventas = desenvolver($('Ventas de hoy'));\nconst abonos = desenvolver($('Abonos de hoy'));\n\nfunction sumarPorForma(items) {\n  const por = {};\n  for (const it of items) por[it.forma_pago] = (por[it.forma_pago] || 0) + it.importe;\n  return por;\n}\n\nconst vPor = sumarPorForma(ventas);\nconst aPor = sumarPorForma(abonos);\nconst totalVentas = ventas.reduce((s, x) => s + x.importe, 0);\nconst totalAbonos = abonos.reduce((s, x) => s + x.importe, 0);\nconst total = totalVentas + totalAbonos;\n\nconst formas = ['efectivo', 'tarjeta', 'bizum'];\nconst lineas = [];\n\nlineas.push('VENTAS DIRECTAS (' + ventas.length + '):');\nif (ventas.length === 0) {\n  lineas.push('  (ninguna)');\n} else {\n  for (const f of formas) if (vPor[f]) lineas.push('  ' + f + ': ' + vPor[f].toFixed(2) + ' EUR');\n  lineas.push('  Total ventas: ' + totalVentas.toFixed(2) + ' EUR');\n}\n\nlineas.push('');\nlineas.push('ABONOS DE APARTADOS (' + abonos.length + '):');\nif (abonos.length === 0) {\n  lineas.push('  (ninguno)');\n} else {\n  for (const f of formas) if (aPor[f]) lineas.push('  ' + f + ': ' + aPor[f].toFixed(2) + ' EUR');\n  lineas.push('  Total abonos: ' + totalAbonos.toFixed(2) + ' EUR');\n}\n\nlineas.push('');\nlineas.push('TOTAL COBRADO HOY: ' + total.toFixed(2) + ' EUR');\nif (ventas.length === 0 && abonos.length === 0) {\n  lineas.push('(Hoy no se ha cobrado nada.)');\n}\n\nconst resumen = lineas.join('\\n');\nconst fecha = $now.toFormat('dd/MM/yyyy');\n\n// Tu texto original, pero con saltos de línea reales\nconst asunto = 'Cierre de caja del ' + fecha;\nconst texto = 'Hola Marisa,\\n\\n'\n  + 'Resumen de hoy:\\n\\n'\n  + resumen + '\\n\\n'\n  + 'Zapatería Paso Firme';\n\nreturn [{\n  json: {\n    fecha: fecha,\n    total: total.toFixed(2),\n    resumen: resumen,\n    asunto: asunto,\n    texto: texto\n  }\n}];"
      },
