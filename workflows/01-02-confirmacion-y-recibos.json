      {
        "parameters": {
          "jsCode": "// La app es la fuente de verdad: aqui solo se valida y se da formato.\nconst body = $json.body || $json;\nconst datos = body.datos || {};\n\nconst obligatorios = ['id', 'cliente', 'producto', 'precio', 'abonado', 'pendiente', 'fecha_limite'];\nconst faltan = obligatorios.filter((k) => datos[k] === undefined || datos[k] === null || datos[k] === '');\n\n// Formato espanol sin depender de la configuracion regional del contenedor.\nconst eur = (n) => {\n  const num = Number(n);\n  if (!Number.isFinite(num)) return '(sin importe)';\n  const [ent, dec] = num.toFixed(2).split('.');\n  return ent.replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.') + ',' + dec + ' €';\n};\n\nconst fecha = (iso) => {\n  const m = String(iso || '').match(/^(\\d{4})-(\\d{2})-(\\d{2})/);\n  return m ? m[3] + '/' + m[2] + '/' + m[1] : String(iso || '(sin fecha)');\n};\n\nconst id = datos.id === undefined || datos.id === null ? 'desconocido' : datos.id;\nconst cliente = datos.cliente || 'cliente sin nombre';\nconst producto = datos.producto || 'producto sin indicar';\nconst talla = datos.talla ? ' · Talla ' + datos.talla : '';\nconst telefono = datos.telefono || 'No indicado';\nconst email = typeof datos.email === 'string' ? datos.email.trim() : '';\n\nconst texto_cliente = [\n  'Hola ' + cliente + ':',\n  '',\n  'Hemos apartado tus zapatos:',\n  '',\n  '- Producto: ' + producto + talla,\n  '- Precio total: ' + eur(datos.precio),\n  '- Abonado hoy: ' + eur(datos.abonado),\n  '- Pendiente: ' + eur(datos.pendiente),\n  '- Fecha límite: ' + fecha(datos.fecha_limite),\n  '',\n  'Puedes pasarte por la tienda antes de esa fecha para completar el pago y recogerlos.',\n  '',\n  '¡Gracias!',\n].join('\\n');\n\nconst texto_sin_email = [\n  'Aviso: el apartado #' + id + ' de ' + cliente + ' se ha creado sin email,',\n  'así que no se ha podido enviar la confirmación.',\n  '',\n  '- Teléfono: ' + telefono,\n  '- Producto: ' + producto + talla,\n  '- Precio total: ' + eur(datos.precio),\n  '- Abonado hoy: ' + eur(datos.abonado),\n  '- Pendiente: ' + eur(datos.pendiente),\n  '- Fecha límite: ' + fecha(datos.fecha_limite),\n  '',\n  'Contacta con el cliente para confirmarle el plazo.',\n].join('\\n');\n\nconst texto_incompleto = [\n  'El evento apartado.creado ha llegado sin los datos necesarios',\n  'y NO se ha enviado ninguna confirmación al cliente.',\n  '',\n  '- Apartado: ' + id,\n  '- Cliente: ' + cliente,\n  '- Faltan: ' + (faltan.length ? faltan.join(', ') : 'ninguno'),\n  '- Datos recibidos: ' + JSON.stringify(datos),\n  '',\n  'Revisa el evento en la app o en la ejecución de n8n.',\n].join('\\n');\n\nreturn [{\n  json: {\n    ...datos,\n    id,\n    email,\n    tiene_email: email ? 1 : 0,\n    faltan,\n    faltan_count: faltan.length,\n    texto_cliente,\n    texto_sin_email,\n    texto_incompleto,\n  },\n}];"
        },
