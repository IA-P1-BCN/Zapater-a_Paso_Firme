      {
        "parameters": {
          "jsCode": "// El importe y el estado vienen de la app: aqui solo se da formato.\nconst body = $json.body || $json;\nconst d = body.datos || {};\n\nconst eur = (n) => {\n  const num = Number(n);\n  if (!Number.isFinite(num)) return '(sin importe)';\n  const [ent, dec] = num.toFixed(2).split('.');\n  return ent.replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.') + ',' + dec + ' €';\n};\n\nconst id = d.id === undefined || d.id === null ? 'desconocido' : d.id;\nconst cliente = d.cliente || 'cliente sin nombre';\nconst producto = d.producto || 'tus zapatos';\nconst email = typeof d.email === 'string' ? d.email.trim() : '';\n\nconst texto_recibo = [\n  'Hola ' + cliente + ':',\n  '',\n  'Hemos recibido tu abono:',\n  '',\n  '- Producto: ' + producto,\n  '- Has pagado ahora: ' + eur(d.importe),\n  '- Total abonado: ' + eur(d.abonado),\n  '- Te queda por pagar: ' + eur(d.pendiente),\n  '',\n  'Gracias por tu compra.',\n].join('\\n');\n\nconst texto_liquidado = [\n  'Hola ' + cliente + ':',\n  '',\n  '¡Ya está pagado! Tu apartado está completo.',\n  '',\n  '- Producto: ' + producto,\n  '- Total pagado: ' + eur(d.abonado),\n  '',\n  'Puedes pasarte por la tienda a recoger tus zapatos.',\n  '',\n  '¡Gracias!',\n].join('\\n');\n\nreturn [{\n  json: {\n    ...d,\n    id,\n    email,\n    tiene_email: email ? 1 : 0,\n    texto_recibo,\n    texto_liquidado,\n  },\n}];"
        },
