    {
      "parameters": {
        "jsCode": "const { desde, hasta, etiqueta } = $('Mes anterior').first().json;\n\n// Lee un nodo ignorando la fila vacía que deja \"Always Output Data\"\nconst leer = (nodo, campo) => $(nodo).all().map(i => i.json).filter(x => x[campo] !== undefined);\n\nconst ventas = leer('Ventas del mes', 'importe');\nconst abonos = leer('Abonos del mes', 'importe');\nconst apartados = leer('Apartados', 'estado');\nconst todosAbonos = leer('Todos los abonos', 'apartado_id');\nconst vales = leer('Vales', 'apartado_id');\n\nif (apartados.length === 0) {\n  throw new Error('No llegaron apartados: no se envía un informe incompleto');\n}\n\nconst delMes = f => f >= desde && f <= hasta;\nconst centimos = v => Math.round(Number(v) * 100);\nconst sumar = (lista, campo) => lista.reduce((s, x) => s + centimos(x[campo]), 0) / 100;\n\nconst totalVentas = sumar(ventas, 'importe');\nconst totalAbonos = sumar(abonos, 'importe');\nconst pendiente = sumar(apartados.filter(a => a.estado === 'activo'), 'pendiente');\n\nconst nuevos = apartados.filter(a => delMes(a.fecha)).length;\n\n// Un apartado se liquida con su último abono\nconst ultimoAbono = {};\nfor (const ab of todosAbonos) {\n  if (!ultimoAbono[ab.apartado_id] || ab.fecha > ultimoAbono[ab.apartado_id]) {\n    ultimoAbono[ab.apartado_id] = ab.fecha;\n  }\n}\nconst liquidados = apartados.filter(a =>\n  a.estado === 'liquidado' && ultimoAbono[a.id] && delMes(ultimoAbono[a.id])\n).length;\n\n// Un apartado vence el día en que se genera su vale\nconst vencidos = vales.filter(v => delMes(v.fecha)).length;\n\nconst eur = v => Number(v).toFixed(2) + ' EUR';\n\nconst asunto = 'Informe de ' + etiqueta + ': lo recaudado y lo que te deben';\n\nconst texto = 'Hola Marisa,\\n\\n'\n  + 'Este es el resumen de ' + etiqueta + ':\\n\\n'\n  + 'RECAUDADO\\n'\n  + 'Ventas directas: ' + eur(totalVentas) + '\\n'\n  + 'Abonos de apartados: ' + eur(totalAbonos) + '\\n'\n  + 'Total recaudado: ' + eur(totalVentas + totalAbonos) + '\\n\\n'\n  + 'PENDIENTE DE COBRO\\n'\n  + 'Total que te deben: ' + eur(pendiente) + '\\n\\n'\n  + 'APARTADOS DEL MES\\n'\n  + 'Nuevos: ' + nuevos + '\\n'\n  + 'Liquidados: ' + liquidados + '\\n'\n  + 'Vencidos: ' + vencidos + '\\n\\n'\n  + 'Zapatería Paso Firme';\n\nreturn [{ json: { asunto: asunto, texto: texto } }];"
      },
